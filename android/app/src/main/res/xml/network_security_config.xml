<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Para desarrollo con IP local -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Emulador -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.1.100</domain> <!-- Tu IP -->
        <domain includeSubdomains="true">TU_DOMINIO.com</domain> <!-- Producción -->
    </domain-config>
    
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>